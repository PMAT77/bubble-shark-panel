# 复制为 .env.test 后使用：cp .env.test.example .env.test
# Copy to .env.test before `pnpm run build:test`.

# 应用配置面板
VITE_APP_SETTING = false

# 网站标题
VITE_APP_TITLE = Game Server Hub · 饥荒联机版开服面板

# 网络请求地址
VITE_APP_API_BASEURL = /

# localStorage/sessionStorage 前缀
VITE_APP_STORAGE_PREFIX = fa_test_

# 调试工具
VITE_APP_DEBUG_TOOL =

# ===== 以下配置仅在测试构建生效 =====

VITE_BUILD_FAKE = true
VITE_BUILD_SOURCEMAP = true
VITE_BUILD_COMPRESS =
VITE_BUILD_ARCHIVE =

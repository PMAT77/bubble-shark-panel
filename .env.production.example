# 复制为 .env.production 后使用：cp .env.production.example .env.production
# Copy to .env.production before `pnpm run build`.

# 应用配置面板
VITE_APP_SETTING = false

# 网站标题
VITE_APP_TITLE = BubbleSharkPanel · 饥荒联机版开服面板

# 网络请求地址（Docker 生产镜像内 Fastify 同域托管静态资源）
VITE_APP_API_BASEURL = /

# localStorage/sessionStorage 前缀
VITE_APP_STORAGE_PREFIX = fa_

# 调试工具，可设置 eruda 或 vconsole（生产留空）
VITE_APP_DEBUG_TOOL =

# ===== 以下配置仅在生产构建生效 =====

# 启用假数据（生产必须为 false）
VITE_BUILD_FAKE = false

# 启用 sourcemap
VITE_BUILD_SOURCEMAP = false

# 压缩方式，支持 gzip 和 brotli。
# 生产默认生成两种压缩资源，由内置静态服务按浏览器支持的格式返回。
VITE_BUILD_COMPRESS = gzip,brotli

# 构建后生成存档，支持 zip 和 tar
VITE_BUILD_ARCHIVE =

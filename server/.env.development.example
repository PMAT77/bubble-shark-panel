# 复制为 server/.env.development 后使用：
# cp server/.env.development.example server/.env.development

SERVER_HOST=0.0.0.0
SERVER_PORT=8888
DB_PATH=./data/bubblesharkpanel.sqlite
SERVER_LOG_DIR=./logs
LOG_LEVEL=debug

# 可选：首次登录强制改密
# FORCE_PASSWORD_CHANGE=1

# 开发默认允许任意 Origin（Vite :9000 代理联调）；可改为 false 或逗号分隔白名单
# CORS_ORIGIN=true
# ADMIN_USERNAME=superadmin
# ADMIN_PASSWORD=123456

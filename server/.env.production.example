# 复制为 server/.env.production 后使用（本地构建验证或自定义镜像）：
# cp server/.env.production.example server/.env.production

SERVER_HOST=0.0.0.0
SERVER_PORT=8888
DB_PATH=./data/bubblesharkpanel.sqlite
SERVER_LOG_DIR=./logs
LOG_LEVEL=info

# 生产环境务必显式设置管理员凭证；未设置 ADMIN_PASSWORD 时将自动生成随机密码并写入启动日志
# ADMIN_USERNAME=superadmin
# ADMIN_PASSWORD=your-strong-password
# FORCE_PASSWORD_CHANGE=1

# CORS：生产默认同源（不反射任意 Origin）。跨域调试可设白名单，如 https://panel.example.com
# CORS_ORIGIN=false

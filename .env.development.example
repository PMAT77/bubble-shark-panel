# 复制为 .env.development 后使用：cp .env.development.example .env.development
# Copy to .env.development before local dev.

# 应用配置面板
VITE_APP_SETTING = true

# 网站标题
VITE_APP_TITLE = BubbleSharkPanel · 饥荒联机版开服面板

# 网络请求地址，应用于 axios 的 baseURL
VITE_APP_API_BASEURL = http://127.0.0.1:8888

# localStorage/sessionStorage 前缀
VITE_APP_STORAGE_PREFIX = fa_dev_

# 调试工具，可设置 eruda 或 vconsole
VITE_APP_DEBUG_TOOL =

# ===== 以下配置仅在开发环境生效 =====

# 开发环境登录页预填（仅 DEV 构建生效）
VITE_DEV_LOGIN_ACCOUNT = superadmin
# 须加引号，否则 vite-plugin-env-parse 会解析为 number，导致登录表单校验失败
VITE_DEV_LOGIN_PASSWORD = "123456"

# 启用代理
VITE_ENABLE_PROXY = true

# 启用假数据（仅开发环境）
VITE_USE_FAKE = false

# 启用 Vue 开发工具
VITE_ENABLE_VUE_DEVTOOLS = false

# 启用 turbo console
VITE_ENABLE_TURBO_CONSOLE = false

# 启动编辑器（vite-plugin-vue-devtools / unplugin-turbo-console）
VITE_LAUNCH_EDITOR = code

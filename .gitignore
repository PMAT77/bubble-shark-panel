# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-*/
.ci-node22/
dist-test/
*.tsbuildinfo
packages/*/dist/
.artifacts/
stats.html
.native-*-probe/
# 一次性探针的原始产物：报告要留档时复制进 docs_local/research/，原始输出不入库
server/scripts/probe-output/

# Internal documentation (not published in open-source repo)
docs_local/

# Public docs: 只发布服主向文档（安装手册、参数速查、内存档位、术语表），
# 其余路径留在本地。新增公开文档时要在下面补一行 !docs/<文件名>。
docs/*
!docs/install-docker.md
!docs/install-native.md
!docs/reference.md
!docs/MEMORY.md
!docs/GLOSSARY.md
!docs/assets/
!docs/assets/**

# Local runtime data & logs
server/data/
server/logs/
data/
logs/
*.sqlite*
**/install-logs/
debug-*.log
*.ndjson

# 历史测试残留（bug 产物：路径变量为 undefined 时落盘的目录）
undefined/

# Environment & secrets (track only *.example templates)
.env
.env.*
!.env.*.example
server/.env
server/.env.*
!server/.env.*.example
panel.env
.dev/

# 授权签发的密钥与产物：私钥与客户许可都不能进仓库。
# 公钥（*.public.pem）不在此列——它本来就要随构建分发，公钥不是秘密。
*.gsh-key
*.gsh-key.public.pem
license-private*.pem
license.json
migration-exports/

# Agent 指令文件（AGENTS.md）随仓库发布：它不匹配任何忽略模式，
# 所以没有例外规则。若将来新增 .agents/ 之类的通配规则，别让它把 AGENTS.md 卷进去。

# IDE & local tooling
.agents/
.skills/
skills/
.cursor/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / coverage
coverage/
.nyc_output/

# Vite / tooling cache
.vite/

# DSH 本地工作目录（验证产物与临时文件）
.agent/
